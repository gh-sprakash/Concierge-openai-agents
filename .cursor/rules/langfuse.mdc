"""
Production-optimized Langfuse configuration
"""

import os
from typing import Dict, Any

class ProductionTracingConfig:
    """Optimized tracing configuration for production environments"""
    
    # Sampling rates for different environments
    SAMPLING_RATES = {
        "development": 1.0,  # Trace everything
        "staging": 0.5,      # Trace 50%
        "production": 0.1,   # Trace 10%
    }
    
    # Feature flags for different tracing capabilities
    FEATURE_FLAGS = {
        "trace_tool_inputs": True,
        "trace_tool_outputs": True,
        "trace_user_queries": True,
        "trace_model_responses": True,
        "trace_session_data": False,  # Disable for privacy
        "enable_evaluations": False,  # Disable expensive evaluations in prod
    }
    
    @classmethod
    def get_config(cls, environment: str = None) -> Dict[str, Any]:
        """Get optimized configuration for environment"""
        env = environment or os.getenv("ENVIRONMENT", "development")
        
        return {
            "sampling_rate": cls.SAMPLING_RATES.get(env, 0.1),
            "features": cls.FEATURE_FLAGS.copy(),
            "batch_size": 100,  # Batch traces for efficiency
            "flush_interval": 30,  # Flush every 30 seconds
            "max_queue_size": 1000,
            "timeout": 10,  # 10 second timeout for trace exports
        }

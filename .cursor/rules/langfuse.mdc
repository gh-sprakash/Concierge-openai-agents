#### 1.3 Core Integration Module
Create `src/tracing/langfuse_integration.py`:

```python
"""
Langfuse Tracing Integration for OpenAI Agents SDK
Provides centralized tracing configuration with minimal overhead
"""

import os
import base64
import logfire
from typing import Optional, Dict, Any
from contextlib import contextmanager
from langfuse import observe, get_client
from agents import get_global_trace_provider


class LangfuseTracer:
    """Centralized Langfuse tracing manager"""
    
    def __init__(self, enabled: bool = None):
        self.enabled = enabled if enabled is not None else os.getenv("LANGFUSE_ENABLED", "false").lower() == "true"
        self.client = None
        
        if self.enabled:
            self._configure_environment()
            self._initialize_tracing()
    
    def _configure_environment(self):
        """Configure OpenTelemetry environment for Langfuse"""
        
        # Validate required environment variables
        required_vars = ["LANGFUSE_PUBLIC_KEY", "LANGFUSE_SECRET_KEY", "LANGFUSE_HOST"]
        missing_vars = [var for var in required_vars if not os.getenv(var)]
        
        if missing_vars:
            raise ValueError(f"Missing required environment variables: {missing_vars}")
        
        # Build Basic Auth header
        langfuse_auth = base64.b64encode(
            f"{os.getenv('LANGFUSE_PUBLIC_KEY')}:{os.getenv('LANGFUSE_SECRET_KEY')}".encode()
        ).decode()
        
        # Configure OpenTelemetry endpoint & headers
        os.environ["OTEL_EXPORTER_OTLP_ENDPOINT"] = os.getenv("LANGFUSE_HOST") + "/api/public/otel"
        os.environ["OTEL_EXPORTER_OTLP_HEADERS"] = f"Authorization=Basic {langfuse_auth}"
        
        # Enable tracing in OpenAI Agents SDK
        if "OPENAI_AGENTS_DISABLE_TRACING" in os.environ:
            del os.environ["OPENAI_AGENTS_DISABLE_TRACING"]
    
    def _initialize_tracing(self):
        """Initialize logfire instrumentation"""
        try:
            # Configure logfire for OpenTelemetry export
            logfire.configure(
                service_name='concierge-sales-assistant',
                service_version='1.0.0',
                send_to_logfire=False,  # Send to Langfuse instead
                console=False,  # Disable console logging for production
            )
            
            # Instrument OpenAI Agents SDK
            logfire.instrument_openai_agents()
            
            # Initialize Langfuse client for custom instrumentation
            self.client = get_client()
            
            print("✅ Langfuse tracing initialized successfully")
            
        except Exception as e:
            print(f"⚠️ Failed to initialize Langfuse tracing: {e}")
            self.enabled = False
    
    @contextmanager
    def trace_session(self, session_name: str, user_id: str = None, metadata: Dict[str, Any] = None):
        """Context manager for tracing user sessions"""
        if not self.enabled:
            yield None
            return
        
        trace_metadata = {
            "session_name": session_name,
            "user_id": user_id,
            "system": "concierge-sales-assistant",
            **(metadata or {})
        }
        
        try:
            with self.client.trace(
                name=session_name,
                user_id=user_id,
                metadata=trace_metadata
            ) as trace:
                yield trace
        except Exception as e:
            print(f"⚠️ Tracing error: {e}")
            yield None
    
    def add_query_metadata(self, query_id: str, user_context: Dict[str, Any] = None, tools_used: list = None):
        """Add metadata to current trace"""
        if not self.enabled or not self.client:
            return
        
        try:
            self.client.update_current_trace(
                tags=["sales-query", "openai-agents"],
                metadata={
                    "query_id": query_id,
                    "user_context": user_context or {},
                    "tools_used": tools_used or [],
                    "version": "1.0.0"
                }
            )
        except Exception as e:
            print(f"⚠️ Failed to add query metadata: {e}")
    
    def flush_traces(self):
        """Ensure all traces are exported (for short-lived processes)"""
        if self.enabled:
            try:
                get_global_trace_provider().force_flush()
            except Exception as e:
                print(f"⚠️ Failed to flush traces: {e}")


# Global tracer instance
tracer = LangfuseTracer()

# Convenience decorators and functions
@observe(capture_input=True, capture_output=True)
def trace_function(func):
    """Decorator to trace individual functions"""
    return func

def observe_tool_call(tool_name: str):
    """Decorator for tracing tool calls with minimal overhead"""
    def decorator(func):
        if not tracer.enabled:
            return func
        
        @observe(name=f"tool_{tool_name}")
        async def wrapper(*args, **kwargs):
            result = await func(*args, **kwargs)
            return result
        return wrapper
    return decorator
```

